# PipeCheck Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key (optional - for AI-powered data fixing)
# Get your free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Database URL (optional - defaults to SQLite)
# DATABASE_URL=sqlite:///./pipecheck.db

# Comma-separated list of allowed browser origins for the API
# CORS_ORIGINS=http://localhost:3000

# Where the frontend looks for the API (build-time, read by react-scripts)
# REACT_APP_API_URL=http://localhost:8001
